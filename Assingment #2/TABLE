.data
msg1: .asciiz "Enter number: "
msg2: .asciiz " x "
msg3: .asciiz " = "
nl: .asciiz "\n"

.text
.globl main

main:
 li $v0, 4
 la $a0, msg1
 syscall

 li $v0, 5
 syscall
 move $t0, $v0

 li $t1, 1

loop:
 bgt $t1, 10, end

 move $a0, $t0
 li $v0, 1
 syscall

 li $v0, 4
 la $a0, msg2
 syscall

 move $a0, $t1
 li $v0, 1
 syscall

 li $v0, 4
 la $a0, msg3
 syscall

 mul $t2, $t0, $t1
 move $a0, $t2
 li $v0, 1
 syscall

 li $v0, 4
 la $a0, nl
 syscall

 addi $t1, $t1, 1
 j loop

end:
  li $v0, 10
  syscall
