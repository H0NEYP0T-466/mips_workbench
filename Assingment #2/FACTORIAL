.data
msg1: .asciiz "Enter number: "
msg2: .asciiz "Factorial = "
nl: .asciiz "\n"

.text
.globl main

main:
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    li $t1, 1
    li $t2, 1

loop:
    bgt $t2, $t0, end

    mul $t1, $t1, $t2
    addi $t2, $t2, 1
    j loop

end:
    li $v0, 4
    la $a0, msg2
    syscall

    move $a0, $t1
    li $v0, 1
    syscall

    li $v0, 4
    la $a0, nl
    syscall

    li $v0, 10
    syscall
